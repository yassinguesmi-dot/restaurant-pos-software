#:kivy 2.2.0

<MainButton@Button>:
    size_hint_y: None
    height: 48
    background_color: 0.2, 0.15, 0.1, 1
    color: 1,1,1,1
    bold: True

<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 24
        spacing: 16
        Label:
            text: 'Café 216 - Connexion'
            font_size: '24sp'
            size_hint_y: None
            height: 50
        TextInput:
            id: username
            hint_text: 'Utilisateur'
            multiline: False
            size_hint_y: None
            height: 44
        TextInput:
            id: password
            hint_text: 'Mot de passe'
            password: True
            multiline: False
            size_hint_y: None
            height: 44
        Label:
            id: status
            text: ''
            color: 1,0.3,0.3,1
            size_hint_y: None
            height: 24
        Button:
            text: 'Se connecter'
            size_hint_y: None
            height: 48
            background_color: 0.8,0.6,0.4,1
            on_press: root.do_login()

<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 12
        spacing: 12
        BoxLayout:
            size_hint_y: None
            height: 60
            spacing: 8
            MainButton:
                text: 'Caisse'
                on_release: app.switch_to('pos')
            MainButton:
                text: 'Produits'
                on_release: app.switch_to('products')
            MainButton:
                text: 'Commandes'
                on_release: app.switch_to('orders')
            MainButton:
                text: 'Rapports'
                on_release: app.switch_to('reports')
            MainButton:
                text: 'Paramètres'
                on_release: app.switch_to('settings')
        BoxLayout:
            canvas.before:
                Color:
                    rgba: 0.1,0.1,0.1,1
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                text: 'Bienvenue dans Café 216 POS (Kivy)'
                color: 1,1,1,1

<POSScreen>:
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: 'Écran POS (à implémenter)'

<ProductsScreen>:
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: 'Produits (à implémenter)'

<OrdersScreen>:
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: 'Commandes (à implémenter)'

<ReportsScreen>:
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: 'Rapports (à implémenter)'

<SettingsScreen>:
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: 'Paramètres (à implémenter)'

<PriceManagementScreen>:
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: 'Prix (à implémenter)'

<StockManagementScreen>:
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: 'Stocks (à implémenter)'

<TablesScreen>:
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: 'Tables (à implémenter)'
