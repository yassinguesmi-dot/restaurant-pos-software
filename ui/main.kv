#:kivy 2.2.0
#:import hex kivy.utils.get_color_from_hex
#:import Window kivy.core.window.Window
#:import dp kivy.metrics.dp

<PrimaryButton@Button>:
    size_hint: 1, None
    height: max(dp(48), Window.height * 0.06)
    background_normal: ''
    background_color: 0, 0, 0, 0
    color: hex('F5E6D3FF')
    bold: True
    canvas.before:
        Color:
            rgba: hex('C27B52FF')
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12, 12, 12, 12]
        Color:
            rgba: 0, 0, 0, 0.18
        RoundedRectangle:
            pos: self.x, self.y - 2
            size: self.width, self.height
            radius: [12, 12, 12, 12]

<MainButton@Button>:
    background_normal: ''
    background_color: 0, 0, 0, 0
    color: hex('F5E6D3FF')
    font_size: '18sp'
    bold: True
    size_hint: 1, None
    height: max(dp(100), Window.height * 0.18)
    canvas.before:
        Color:
            rgba: hex('1D1A24FF')
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14, 14, 14, 14]

<GhostButton@Button>:
    size_hint: 1, None
    height: max(dp(44), Window.height * 0.055)
    background_normal: ''
    background_color: 0, 0, 0, 0
    color: hex('F5E6D3FF')
    canvas.before:
        Color:
            rgba: hex('FFFFFF1A')
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10, 10, 10, 10]
        Color:
            rgba: 0, 0, 0, 0.12
        RoundedRectangle:
            pos: self.x, self.y - 1
            size: self.width, self.height
            radius: [10, 10, 10, 10]

<PanelCard@BoxLayout>:
    orientation: 'vertical'
    padding: dp(18)
    spacing: dp(12)
    size_hint_y: None
    height: self.minimum_height
    canvas.before:
        Color:
            rgba: hex('1D1A24FF')
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [18, 18, 18, 18]
        Color:
            rgba: 0, 0, 0, 0.16
        RoundedRectangle:
            pos: self.x, self.y - 3
            size: self.width, self.height
            radius: [18, 18, 18, 18]

<LoginScreen>:
    canvas.before:
        Color:
            rgba: hex('120F16FF')
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: hex('FFFFFF0D')
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: hex('C27B520F')
        Rectangle:
            size: self.width * 0.8, self.height * 0.6
            pos: self.center_x - self.width * 0.4, self.center_y - self.height * 0.3
    AnchorLayout:
        padding: 24
        PanelCard:
            size_hint: 0.9, None
            width: min(self.width * 0.9, dp(480))
            Label:
                text: 'Café 216'
                font_size: '26sp'
                color: hex('F5E6D3FF')
                size_hint_y: None
                height: max(dp(40), Window.height * 0.05)
            Label:
                text: 'Connexion'
                font_size: '18sp'
                color: hex('B9A48EFF')
                size_hint_y: None
                height: max(dp(32), Window.height * 0.04)
            TextInput:
                id: username
                hint_text: 'Utilisateur'
                multiline: False
                size_hint_y: None
                height: max(dp(46), Window.height * 0.06)
                background_color: hex('FFFFFF12')
                foreground_color: hex('F5E6D3FF')
                cursor_color: hex('C27B52FF')
                padding: [12, 10, 12, 10]
            TextInput:
                id: password
                hint_text: 'Mot de passe'
                password: True
                multiline: False
                size_hint_y: None
                height: max(dp(46), Window.height * 0.06)
                background_color: hex('FFFFFF12')
                foreground_color: hex('F5E6D3FF')
                cursor_color: hex('C27B52FF')
                padding: [12, 10, 12, 10]
            Label:
                id: status
                text: ''
                color: 1,0.5,0.5,1
                size_hint_y: None
                height: max(dp(24), Window.height * 0.03)
            PrimaryButton:
                text: 'Se connecter'
                on_press: root.do_login()
            GhostButton:
                text: 'Quitter'
                on_press: app.stop()

<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 18
        spacing: 16
        canvas.before:
            Color:
                rgba: hex('120F16FF')
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            size_hint_y: None
            height: max(dp(64), Window.height * 0.08)
            padding: dp(4)
            Label:
                text: 'Tablette POS'
                font_size: '22sp'
                color: hex('F5E6D3FF')
            GhostButton:
                text: 'Déconnexion'
                size_hint_x: None
                width: 130
                on_release: app.switch_to('login')
        GridLayout:
            cols: 2
            spacing: dp(14)
            size_hint_y: None
            row_default_height: max(dp(100), Window.height * 0.18)
            row_force_default: True
            height: self.minimum_height
            MainButton:
                text: 'Caisse'
                on_release: app.switch_to('pos')
            MainButton:
                text: 'Produits'
                on_release: app.switch_to('products')
            MainButton:
                text: 'Commandes'
                on_release: app.switch_to('orders')
            MainButton:
                text: 'Rapports'
                on_release: app.switch_to('reports')
            MainButton:
                text: 'Paramètres'
                on_release: app.switch_to('settings')
            MainButton:
                text: 'Prix'
                on_release: app.switch_to('price_mgmt')
            MainButton:
                text: 'Stocks'
                on_release: app.switch_to('stock')
            MainButton:
                text: 'Tables'
                on_release: app.switch_to('tables')
        PanelCard:
            Label:
                text: 'Bienvenue dans Café 216 POS (version mobile)'
                color: hex('F5E6D3FF')
            Label:
                text: 'Sélectionnez un module pour continuer.'
                color: hex('B9A48EFF')

<POSScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 16
        spacing: 14
        canvas.before:
            Color:
                rgba: hex('120F16FF')
            Rectangle:
                pos: self.pos
                size: self.size
        PanelCard:
            Label:
                text: 'Écran POS (à implémenter)'
                color: hex('F5E6D3FF')
            GhostButton:
                text: 'Retour'
                on_release: app.switch_to('home')

